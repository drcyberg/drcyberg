    {
        "id": "cpu_dashboard_inject",
        "type": "inject",
        "z": "cpu_dashboard_tab",
        "name": "Frissítés 5 mp-ként",
        "props": [
            {
                "p": "payload"
            },
            {
                "p": "topic",
                "vt": "str"
            }
        ],
        "repeat": "5",
        "crontab": "",
        "once": true,
        "onceDelay": "1",
        "topic": "cpu",
        "payload": "",
        "payloadType": "date",
        "x": 150,
        "y": 120,
        "wires": [
            [
                "cpu_dashboard_function"
            ]
        ]
    },
    {
        "id": "cpu_dashboard_function",
        "type": "function",
        "z": "cpu_dashboard_tab",
        "name": "CPU % (/proc/stat)",
        "func": "const fs = global.get('fs') || require('fs');\n\nfunction readCpu() {\n    const line = fs.readFileSync('/proc/stat', 'utf8').split('\\n')[0];\n    const parts = line.trim().split(/\\s+/).slice(1).map(Number);\n    const idle = parts[3] + (parts[4] || 0);\n    const total = parts.reduce((sum, value) => sum + value, 0);\n    return { idle, total };\n}\n\nconst previous = context.get('lastCpu');\nconst current = readCpu();\n\nlet cpuPercent = 0;\n\nif (previous) {\n    const idleDelta = current.idle - previous.idle;\n    const totalDelta = current.total - previous.total;\n    if (totalDelta > 0) {\n        cpuPercent = Math.round((1 - idleDelta / totalDelta) * 1000) / 10;\n    }\n}\n\ncontext.set('lastCpu', current);\n\nmsg.payload = cpuPercent;\nmsg.topic = 'cpu';\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 120,
        "wires": [
            [
                "cpu_dashboard_gauge",
                "cpu_dashboard_chart",
                "cpu_dashboard_text"
            ]
        ]
    },
